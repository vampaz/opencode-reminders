{
  "name": "opencode-reminders",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode 2 plugin that turns reminders into a desktop feature: tools, panel, palette command, settings page, and native notifications",
  "keywords": [
    "notifications",
    "opencode-plugin",
    "reminders"
  ],
  "homepage": "https://github.com/vampaz/opencode-reminders#readme",
  "bugs": {
    "url": "https://github.com/vampaz/opencode-reminders/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vampaz/opencode-reminders.git"
  },
  "files": [
    "index.ts",
    "src",
    "dist"
  ],
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:gui": "vite build",
    "dev:gui": "vite build --watch"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.5",
    "@types/node": "^24.0.0",
    "effect": "^4.0.6",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5"
  },
  "engines": {
    "node": ">=22"
  }
}
